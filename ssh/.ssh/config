# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Host github.com
# 	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

ServerAliveInterval     60
TCPKeepAlive            yes
VerifyHostKeyDNS        no
ForwardX11              no
CanonicalizeHostname    yes
CanonicalDomains        prod.booking.com corp.booking.com

# Please replace lohuang with your username, and uncomment the User lines.
# Required if your laptop username differs from your Booking username.

# Development using direct access.
Host *.dev
    ForwardAgent        yes
    User                lohuang
    Hostname            lohuang-%h.booking.com
    ProxyCommand        none

Host *.dev.booking.com
    ForwardAgent        yes
    User                lohuang
    ProxyCommand        none

Host app book cron off adm
    ForwardAgent        yes
    User                lohuang
    Hostname            lohuang-%h.dev.booking.com
    ProxyCommand        none

# Jump host and SSH Key Injector using direct access.
Host jump.booking.com trace.jump.booking.com citadel.booking.com ssh.booking.com citadel-* *citadel-*.booking.com
    ForwardAgent        yes
    User                lohuang
    ProxyCommand        none

# Hadoop KVMs.
Host *-devhadoop-*.ams30.dev.booking.com *-devhadoop-*.lon1.dev.booking.com
    ForwardAgent        yes
    User                lohuang
    ProxyCommand        none

# Production and DQS using citadel.booking.com.
Host !gitlab.booking.com !*.dev.booking.com !gitlab.com !github.com *-?? *-??? *-???? *-????? 10.* *.corpad.adbkng.com *.booking.com !*.local
    ForwardAgent        yes
    User                lohuang
    #ProxyCommand        ssh -q citadel.booking.com ssh-proxy %h %p # Jump using citadel 1.0
    ProxyCommand        ssh -W %r@%h:%p jump.booking.com           # Jump using citadel 2.0

Host trace.jump.booking.com
    RemoteCommand       trace
    RequestTTY          yes
    Hostname            jump.booking.com
    User                lohuang

