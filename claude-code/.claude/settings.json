{
  "apiKeyHelper": "bk auth:issue-token || (bk auth:login --skip-okta-auth > /dev/null 2>&1 && bk auth:issue-token)",
  "env": {
    "ANTHROPIC_BASE_URL": "https://gen-ai.prod.booking.com/anthropic/claude_code/",
    "ENABLE_TOOL_SEARCH": "false",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__Toolbox-Preview__search_tools",
      "Bash(ssh -G ssh.booking.com)",
      "Bash(bk genai:skill:list)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Bash(awk ' *)",
      "Bash(bk genai *)",
      "Bash(bk genai:skill:list --help)",
      "Bash(bk commands *)",
      "Bash(bk genai:skill --help)",
      "Bash(bk genai:skill:install *)",
      "Bash(grep -E '^ common/\\(simplify|detect-context|converge-simplify|simplify-branch\\)$' bkskills.txt)",
      "Bash(python3 -)",
      "Bash(grep -iE '\\\\.\\(yaml|yml|json\\)$')",
      "Read(//Users/lohuang/.agents/**)",
      "Bash(bash /Users/lohuang/.agents/skills/code-review/scripts/code-review.sh --help)",
      "Bash(echo \"--- exit: $?\")",
      "Bash(shasum -a 256 /Users/lohuang/.agents/skills/code-review/scripts/code-review.sh /Users/lohuang/.agents/skills/sonarfix/scripts/get-gitlab-mr.sh)",
      "Bash(chmod +x /Users/lohuang/.agents/skills/code-review/scripts/code-review.sh /Users/lohuang/.agents/skills/sonarfix/scripts/get-gitlab-mr.sh)",
      "Bash(glab api *)",
      "Bash(python3 -c ' *)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  },
  "companyAnnouncements": [
    "Welcome to Claude Code at Booking.com! For tips and troubleshooting, see https://u.booking.com/claudecode."
  ]
}
