prefix_rule(pattern=["acli", "jira", "workitem", "view"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["glab", "mr", "list"], decision="allow")
