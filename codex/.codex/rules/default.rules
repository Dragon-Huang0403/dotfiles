prefix_rule(pattern=["/bin/zsh", "-lc", "mvn", "test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "mvn", "clean", "test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "SRC_ENDPOINT=https://sourcegraph.booking.com", "src", "search"], decision="allow")
